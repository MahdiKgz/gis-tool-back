NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=snapgis
POSTGRES_USER=snapgis
POSTGRES_PASSWORD=snapgis_dev_password
POSTGRES_SSL=false
DATABASE_URL=postgresql://snapgis:snapgis_dev_password@localhost:5432/snapgis?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_ISSUER=snapgis-api
JWT_AUDIENCE=snapgis-web
REFRESH_TOKEN_TTL_SECONDS=604800

# Local development: MinIO's S3 API and private console are bound to loopback.
# Use an HTTPS public endpoint behind ops/nginx-storage.conf in production.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=snapgis-files
S3_REGION=us-east-1
MINIO_ROOT_USER=snapgis_admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-admin-secret
MINIO_APP_USER=snapgis_app
MINIO_APP_SECRET=replace-with-a-different-long-random-app-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
