generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(100)
  phone              String              @unique @db.VarChar(20)
  passwordHash       String              @map("password_hash")
  sessionVersion     Int                 @default(0) @map("session_version")
  email              String?             @unique @db.VarChar(254)
  emailVerifiedAt    DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  pendingEmail       String?             @map("pending_email") @db.VarChar(254)
  emailTokenHash     String?             @map("email_token_hash")
  emailTokenExpires  DateTime?           @map("email_token_expires") @db.Timestamptz(6)
  resetTokenHash     String?             @unique @map("reset_token_hash")
  resetTokenExpires  DateTime?           @map("reset_token_expires") @db.Timestamptz(6)
  roles              String[]            @default(["user"])
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  uploadedFiles      UploadedFile[]
  planCode           PlanCode            @default(starter) @map("plan_code")
  ownedCompany       Company?            @relation("CompanyOwner")
  companyMembership  CompanyMember?
  companyInvitations CompanyInvitation[]
  spatialImages      SpatialImage[]
  uploadActivity     UploadActivity[]
  planAssignments    PlanAssignment[]    @relation("PlanTarget")
  assignedPlans      PlanAssignment[]    @relation("PlanActor")
  articles           Article[]

  @@index([createdAt])
  @@map("users")
}

enum ArticleStatus {
  draft
  published
}

model Article {
  id            String        @id @default(uuid()) @db.Uuid
  authorId      String        @map("author_id") @db.Uuid
  title         String        @db.VarChar(180)
  slug          String        @unique @db.VarChar(220)
  excerpt       String        @db.VarChar(360)
  content       String
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(1000)
  category      String        @db.VarChar(80)
  keywords      String[]      @default([])
  status        ArticleStatus @default(draft)
  publishedAt   DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  author        User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId, updatedAt])
  @@index([authorId, status])
  @@index([status, publishedAt])
  @@index([category, status])
  @@map("articles")
}

model UploadedFile {
  id               String   @id @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  name             String   @db.VarChar(150)
  originalName     String   @map("original_name") @db.VarChar(255)
  storedFileName   String   @map("stored_file_name") @db.VarChar(255)
  storagePath      String   @map("storage_path")
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeInBytes      Int      @map("size_in_bytes")
  healStatus       String   @default("dry-run-complete") @map("heal_status") @db.VarChar(24)
  identifiedIssues Int      @default(0) @map("identified_issues")
  healedIssues     Int      @default(0) @map("healed_issues")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, healStatus])
  @@index([createdAt])
  @@map("uploaded_files")
}

model Analysis {
  id      String @id @db.Uuid
  payload Json
  report  Json?

  @@map("analyses")
}

model StorageUpload {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  key          String
  originalName String    @map("original_name")
  size         Int
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  claimedAt    DateTime? @map("claimed_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("storage_uploads")
}

enum PlanCode {
  starter
  pro
  advanced
}

enum CompanyInviteStatus {
  pending
  accepted
  declined
  revoked
  expired
}

model Company {
  id          String              @id @default(uuid()) @db.Uuid
  ownerId     String              @unique @map("owner_id") @db.Uuid
  name        String              @db.VarChar(150)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       User                @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     CompanyMember[]
  invitations CompanyInvitation[]
  activity    UploadActivity[]
  spatialImages SpatialImage[]

  @@map("companies")
}

enum SpatialImageStatus {
  uploading
  processing
  ready
  failed
  deleting
}

model SpatialImage {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @map("company_id") @db.Uuid
  uploaderId  String             @map("uploader_id") @db.Uuid
  name        String             @db.VarChar(255)
  size        BigInt
  status      SpatialImageStatus @default(uploading)
  uploadETag  String?            @map("upload_etag")
  errorCode   String?            @map("error_code")
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploader    User               @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([status, expiresAt])
  @@map("spatial_images")
}

model CompanyMember {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_members")
}

model CompanyInvitation {
  id          String              @id @default(uuid()) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  status      CompanyInviteStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime            @map("expires_at") @db.Timestamptz(6)
  respondedAt DateTime?           @map("responded_at") @db.Timestamptz(6)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status, expiresAt])
  @@index([userId, status])
  @@map("company_invitations")
}

model UploadActivity {
  id               String    @id @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  companyId        String?   @map("company_id") @db.Uuid
  sizeInBytes      Int       @map("size_in_bytes")
  identifiedIssues Int       @map("identified_issues")
  healedIssues     Int       @default(0) @map("healed_issues")
  healStatus       String    @default("dry-run-complete") @map("heal_status")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("upload_activity")
}

model PlanAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  previousPlan PlanCode @map("previous_plan")
  nextPlan     PlanCode @map("next_plan")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user         User     @relation("PlanTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor        User     @relation("PlanActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("plan_assignments")
}
